# ===== UniTrack Backend Environment Variables =====
# Copy this file to your environment or CI/CD pipeline.
# All values below are REQUIRED in production.

# Database
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# JWT
JWT_SECRET=your_base64_encoded_secret_key

# Email (SendGrid HTTP API)
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=your_from_email@example.com
SENDGRID_FROM_NAME=UniTrack

# Google OAuth2
GOOGLE_CLIENT_ID=your_google_client_id

# Super Admin
SUPER_ADMIN_EMAIL=your_super_admin@email.com

# CORS (comma-separated for multiple origins)
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com
